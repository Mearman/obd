{
  "name": "obd-read",
  "version": "0.1.0",
  "private": true,
  "description": "Read cars through ELM327-style adapters, in Node and in the browser.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./profiles": {
      "types": "./dist/profiles/index.d.ts",
      "default": "./dist/profiles/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./web/storage": {
      "types": "./dist/web/storage.d.ts",
      "default": "./dist/web/storage.js"
    }
  },
  "bin": {
    "obd-read": "./dist/node/bin.js"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:parity": "vitest run test/parity",
    "build": "tsc -p tsconfig.build.json",
    "storage:generate": "drizzle-kit generate && node scripts/embed-migrations.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/w3c-web-serial": "1.0.9",
    "@types/w3c-web-usb": "1.0.14",
    "@types/web-bluetooth": "0.0.22",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "smol-toml": "1.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "@orpc/client": "2.0.0-beta.49",
    "@orpc/contract": "2.0.0-beta.49",
    "@orpc/server": "2.0.0-beta.49",
    "@stoprocent/noble": "2.8.0",
    "drizzle-orm": "1.0.0-rc.5",
    "fast-xml-parser": "5.12.1",
    "fast-xml-validator": "1.4.3",
    "fflate": "0.8.3",
    "mqtt": "5.16.1",
    "serialport": "13.0.0",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "socketcan": "4.3.2"
  }
}
